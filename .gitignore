*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Python
__pycache__/
*.py[oc]
.venv/
venv/

# Rahasia
.env
.env.*
!.env.example

# Berkas sementara editor
*.swp
*~
.DS_Store

